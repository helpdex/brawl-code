      },
      "accent": "$hue.orange",
      "interactive": "$hue.orange",
      "neutral": "$hue.gray"
    },
    "@dialog": {
      "background": {
        "base": "$hue.neutral.700",
        "action": {
          "primary": {
            "$hovered": "$hue.neutral.600"
          }
        }
      }
    },
    "syntax": {
      "variable": "#e4e4e7"
    }
  }
}
