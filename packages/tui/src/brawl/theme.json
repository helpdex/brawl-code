        "900": "#fdf8ee"
      },
      "blue": {
        "100": "#1453b8",
        "200": "#1f66d1",
        "300": "#3a7de0",
        "400": "#5c96ea",
        "500": "#86b2f2",
        "600": "#b2cef8",
        "700": "#d6e5fb",
        "800": "#ebf2fd",
        "900": "#f6f9fe"
      },
      "purple": {
        "100": "#5b3cb0",
        "200": "#6e4fc7",
        "300": "#8466d6",
        "400": "#9c82e2",
        "500": "#b7a2ec",
        "600": "#d2c4f4",
