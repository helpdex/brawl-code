        "300": "#d69c2a",
        "400": "#b07f20",
        "500": "#8a6318",
        "600": "#5a4614",
        "700": "#3a2e10",
        "800": "#2a2210",
        "900": "#161107"
      },
      "blue": {
        "100": "#a6cdff",
