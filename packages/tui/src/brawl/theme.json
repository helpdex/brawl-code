        "900": "#faf8fe"
      },
      "accent": "$hue.orange",
      "interactive": "$hue.orange",
      "neutral": "$hue.gray"
    },
    "text": {
      "action": {
        "primary": {
          "$focused": "$hue.neutral.900"
        },
        "destructive": {
          "base": "$hue.neutral.900"
        }
      }
    },
    "diff": {
      "text": {
        "added": "#16854f",
        "removed": "#c9343a",
        "context": "$hue.neutral.300",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "#e6f7ee",
        "removed": "#fde9ea"
      },
      "highlight": {
        "added": "#3fb37a",
        "removed": "#dc4a50"
      },
      "lineNumber": {
        "text": "#71717a",
        "background": {
          "added": "#d6f0e2",
          "removed": "#f8d9db"
        }
      }
    },
    "syntax": {
      "variable": "#27272a"
    }
  },
